# =============================================================================
# KDU Developer Community - Django application
#
# Copy this to .env and fill it in. Never commit the real file; .env is in
# .gitignore.
#
#   cp .env.example .env
#
# The email settings use the SAME names and the SAME Google App Password as
# the Netlify function on the static site, so nothing new has to be generated.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED - the app will not start without these in production
# -----------------------------------------------------------------------------

# Generate a fresh one, do not reuse anything:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Never 1 in production.
DJANGO_DEBUG=0

# Comma separated. The hostnames this app answers on. No scheme, no slash.
DJANGO_ALLOWED_HOSTS=community.example.org

# The public hostname, with scheme. Used for CSRF, and by nginx and Certbot.
CSRF_TRUSTED_ORIGINS=https://community.example.org


# -----------------------------------------------------------------------------
# REQUIRED for docker-compose.prod.yml
# -----------------------------------------------------------------------------

# The hostname nginx serves and Certbot issues a certificate for. Must match
# the DNS A record and DJANGO_ALLOWED_HOSTS above.
APP_HOST=community.example.org

# The image CI publishes. Leave as is unless the repository is renamed.
APP_IMAGE=ghcr.io/devcom-goseong/community-web-django:latest

# Postgres. Choose a long password; nothing outside the compose network can
# reach the database, but it is still a password.
POSTGRES_DB=kdu
POSTGRES_USER=kdu
POSTGRES_PASSWORD=
# Must match the three values above.
DATABASE_URL=postgres://kdu:CHANGE_ME@db:5432/kdu


# -----------------------------------------------------------------------------
# EMAIL - the same account and App Password the Netlify form already uses
# -----------------------------------------------------------------------------

# The Gmail address that sends the mail.
GMAIL_USER=

# A 16-character Google App Password, NOT the account password. If the form on
# the static site is already working, this is the identical value.
# Generate at https://myaccount.google.com/apppasswords (2-Step Verification
# must be on first).
GMAIL_APP_PASSWORD=

# Where notifications about new applications go. Defaults to GMAIL_USER.
TEAM_INBOX=

# 465 for implicit TLS (default), or 587 for STARTTLS if 465 is blocked.
GMAIL_SMTP_PORT=465


# -----------------------------------------------------------------------------
# OPTIONAL - every one of these has a working default
# -----------------------------------------------------------------------------

# Origins allowed to post the form here from another site. Only needed while
# the static Netlify site is still the front end.
PUBLIC_SITE_ORIGINS=https://dev-comm.netlify.app

# Used in the emails, to link the rules, terms and privacy notice.
PUBLIC_SITE_URL=https://dev-comm.netlify.app

# Where the join form posts. Same-origin by default.
# FORM_ENDPOINT=/api/register

# Console instead of real email, useful while developing:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_TIMEOUT=10

# nginx already redirects http to https, so Django must not redirect again or
# plain-HTTP health checks loop. The production compose sets this to 0.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000

# Use an in-process cache instead of the database one. Only for CI and local
# runs; in production the database cache is what makes rate limiting apply
# across all the gunicorn workers rather than one at a time.
# DJANGO_LOCMEM_CACHE=0

# GUNICORN_WORKERS=2
# DJANGO_TIME_ZONE=Asia/Seoul
# DJANGO_LOG_LEVEL=INFO

# Form protection. Submissions faster than MIN_FILL_SECONDS are refused.
# MIN_FILL_SECONDS=1.5
# MAX_FILL_SECONDS=43200
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_SECONDS=600
